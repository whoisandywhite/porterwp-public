{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#212121",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#0057b8",
					"name": "Accent",
					"slug": "accent"
				}
			]
		},
		"layout": {
			"contentSize": "60rem",
			"wideSize": "84rem"
		},
		"spacing": {
			"blockGap": true,
			"customSpacingSize": true,
			"spacingSizes": [
				{
					"name": "2X Small",
					"size": "0.25rem",
					"slug": "20"
				},
				{
					"name": "X Small",
					"size": "0.5rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "0.75rem",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(1.5rem, 2vw, 2rem)",
					"slug": "60"
				},
				{
					"name": "X Large",
					"size": "clamp(2rem, 4vw, 3rem)",
					"slug": "70"
				},
				{
					"name": "2X Large",
					"size": "clamp(3rem, 6vw, 5rem)",
					"slug": "80"
				}
			],
			"units": [
				"px",
				"rem",
				"em",
				"%",
				"vw",
				"vh"
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "System Sans",
					"slug": "system-sans"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					},
					"name": "Large",
					"size": "2rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "3.5rem"
					},
					"name": "X Large",
					"size": "3.5rem",
					"slug": "x-large"
				}
			],
			"lineHeight": true,
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				}
			}
		},
		"spacing": {
			"blockGap": "var:preset|spacing|50",
			"padding": {
				"bottom": "0",
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50",
				"top": "0"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
